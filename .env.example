# Create a PRIVATE Vercel Blob store and connect it to this project.
# Current Vercel uses BLOB_STORE_ID with OIDC; a read/write token also works.
BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# Run npm run setup:admin, then copy these values from private/admin-setup.txt.
# Never put secrets in NEXT_PUBLIC_* variables or commit .env.local/private/.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Optional: defaults to production.json, an isolated preview branch, or local.json.
# CURRICULUM_BLOB_PATH=curriculum/production.json
